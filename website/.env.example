# Degen Walkie site v3 — environment variables
# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.
# Pre-orders stay in "open soon" mode until STRIPE_SECRET_KEY is set to a real key.

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Secret key. Test keys start with sk_test_, live keys with sk_live_. Server-only, never exposed to the browser.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Publishable key (pk_test_… / pk_live_…). Safe to expose; currently informational (Checkout is hosted by Stripe).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Optional: a Price ID (price_…) for the $99 Genesis pre-order. If empty, the API falls back to inline price_data.
STRIPE_PRICE_ID=
# Webhook signing secret from Dashboard → Developers → Webhooks (whsec_…). Needed for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Site ---
# Public origin used to build Stripe success/cancel URLs and OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Built in the open (optional; the section hides if both are unset) ---
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=

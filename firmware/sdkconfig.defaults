# ESP32-S3-MINI-1-N4R2: 4 MB flash, 2 MB quad PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# TLS buffers in PSRAM: the device keeps several HTTPS / WSS connections open at once
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Software AES: hardware AES needs a DMA bounce buffer in internal RAM per record,
# and internal RAM runs out with several TLS sockets open ("esp-aes: Failed to allocate memory")
CONFIG_MBEDTLS_HARDWARE_AES=n
# Wi-Fi and lwIP buffers in PSRAM (internal RAM is the scarce one), and a bigger TCP
# window so a voice clip uploads in a couple of seconds instead of twenty
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Native USB for logs and flashing
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# TLS to the venues
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# LVGL uses core/lv_conf.h
CONFIG_LV_CONF_SKIP=n
# Skip LVGL examples and demos
CONFIG_LV_BUILD_EXAMPLES=n

{
  "name": "degen-walkie-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Browser simulator for the Degen Walkie firmware, with mock Hyperliquid, Pacifica, Lighter and relay servers.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --target=es2020 --minify --sourcemap --outfile=public/sim.js && esbuild src/link.js --bundle --format=esm --target=es2020 --minify --outfile=public/link.js",
    "dev": "esbuild src/main.js --bundle --format=esm --target=es2020 --sourcemap --outfile=public/sim.js --watch --servedir=public"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0"
  }
}
